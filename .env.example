# BaseStocks Bot
#
# Every value is optional. A surface with no token is simply off: its webhook answers 404 and the
# rest of the service keeps working. Nothing here is read in the browser, so no key is NEXT_PUBLIC.

# ---------------------------------------------------------------- Telegram
# From @BotFather. One token per handle. Two handles exist because a compliance notice about a
# restricted instrument and a feed of permissionless community tokens cannot share a mute setting.
TELEGRAM_BSTOCKS_TOKEN=
TELEGRAM_LAUNCHPAD_TOKEN=

# The header Telegram sends with every update, and the only proof it really came from Telegram.
# Telegram accepts A-Z a-z 0-9 _ - only, 1 to 256 characters. Mint one with:
#   node scripts/setup-telegram.mjs secret
TELEGRAM_BSTOCKS_SECRET=
TELEGRAM_LAUNCHPAD_SECRET=

# Where health alerts go. A private chat with the operator, never a group with users in it.
# The chat reads alerts and cannot run anything.
TELEGRAM_OPS_CHAT_ID=

# ---------------------------------------------------------------- Upstream
# Overridable so a preview deployment can point at preview deployments of the two products.
BSTOCKS_URL=https://basestocks.finance
LAUNCHPAD_URL=https://launchpad.basestocks.finance

# ---------------------------------------------------------------- Registration
# Used only by scripts/setup-telegram.mjs, to build the webhook URL. Must be https.
APP_URL=

# ---------------------------------------------------------------- Assistant
# Free-text answers, relayed to the BStocks assistant endpoint. Off by default: that endpoint meters
# by request IP, and behind a webhook every Telegram user arrives from Telegram's datacenter, so one
# person could spend the website's daily allowance. Turn this on only once it can be told who asked.
ASSISTANT_ENABLED=false
ASSISTANT_DAILY_LIMIT_PER_USER=20

# ---------------------------------------------------------------- State
# Optional. Without it, de-duplication and metering are per instance, which is fine for one region
# and wrong the moment there are several. Both or neither.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------- Cron
# Guards /api/cron/alerts. Vercel sends it as `Authorization: Bearer <value>`. 32+ random characters.
CRON_SECRET=
